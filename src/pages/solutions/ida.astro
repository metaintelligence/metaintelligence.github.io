---
import Layout from '~/layouts/PageLayout.astro';
import Header from '~/components/widgets/Header.astro';
import Hero2 from '~/components/widgets/Hero2.astro';
import Features3 from '~/components/widgets/Features3.astro';
import Steps from '~/components/widgets/Steps.astro';
import Features2 from '~/components/widgets/Features2.astro';
import Content from '~/components/widgets/Content.astro';
import WidgetWrapper from '~/components/ui/WidgetWrapper.astro';
import Headline from '~/components/ui/Headline.astro';
import { Icon } from 'astro-icon/components';

import { headerData } from '~/navigation';

import uploadScreen from '~/assets/images/ida/ida_new_upload.png';
import overviewScreen from '~/assets/images/ida/ida_result_overview.png';
import chartsScreen from '~/assets/images/ida/ida_result_charts.png';
import detailScreen from '~/assets/images/ida/ida_item_detail.png';
import insightsScreen from '~/assets/images/ida/ida_insights.png';
import mobileScreen from '~/assets/images/ida/ida_mobile_projects.png';

const metadata = {
  title: 'IDA — Intelligent Document Analyzer',
  description:
    'IDA is a document and record analytics AI built on MetaInsight. It surfaces keyword clusters and time-series signals in CSV/Excel/Parquet data and produces evidence-backed insights.',
};

const bi = (k: string, e: string) => `<span data-lang-ko>${k}</span><span data-lang-en>${e}</span>`;

const screenItems = [
  {
    titleKo: '분석 생성',
    titleEn: 'New Analysis',
    descriptionKo: '파일 업로드에서 컬럼 매핑, 분석 프리셋 선택으로 이어지는 3단계 흐름',
    descriptionEn: 'The three-step flow: file upload, column mapping, and analysis preset selection.',
    image: uploadScreen,
    altKo: 'MetaInsight 새 분석 업로드 화면',
    altEn: 'MetaInsight new-analysis upload screen',
    icon: 'tabler:upload',
  },
  {
    titleKo: '결과 요약',
    titleEn: 'Results Overview',
    descriptionKo: '레코드, 그룹, 감지된 시그널, 전체 클러스터를 한 화면에서 확인',
    descriptionEn: 'See records, groups, detected signals, and all clusters in one view.',
    image: overviewScreen,
    altKo: 'MetaInsight 분석 결과 요약 화면',
    altEn: 'MetaInsight analysis results overview',
    icon: 'tabler:layout-dashboard',
  },
  {
    titleKo: '분포와 비교',
    titleEn: 'Distribution &amp; Comparison',
    descriptionKo: '등급 분포, 그룹 비교, Top Signals를 차트로 확인',
    descriptionEn: 'Visualize grade distribution, group comparisons, and top signals as charts.',
    image: chartsScreen,
    altKo: 'MetaInsight 결과 차트 화면',
    altEn: 'MetaInsight results chart view',
    icon: 'tabler:chart-donut',
  },
  {
    titleKo: '항목 상세',
    titleEn: 'Cluster Detail',
    descriptionKo: '클러스터별 점수, 통과 기준, 레코드 수, 키워드 구성을 상세 검토',
    descriptionEn: 'Inspect per-cluster scores, pass criteria, record counts, and keyword composition.',
    image: detailScreen,
    altKo: 'MetaInsight 항목 상세 화면',
    altEn: 'MetaInsight item detail view',
    icon: 'tabler:list-details',
  },
  {
    titleKo: '인사이트',
    titleEn: 'Insights',
    descriptionKo: '분석 결과를 요약하고 주요 클러스터별 근거를 자연어로 정리',
    descriptionEn: 'Summarize the analysis and lay out per-cluster evidence in natural language.',
    image: insightsScreen,
    altKo: 'MetaInsight 인사이트 화면',
    altEn: 'MetaInsight insights view',
    icon: 'tabler:sparkles',
  },
];

const initialScreen = screenItems[1];
---

<Layout metadata={metadata}>
  <Fragment slot="header">
    <Header {...headerData} isSticky showToggleTheme showToggleLanguage />
  </Fragment>

  <Hero2 tagline="IDA · Intelligent Document Analyzer">
    <Fragment slot="title">
      <span data-lang-ko
        >문서 데이터를<br />
        <span class="text-accent">정량 근거로 분석</span></span
      >
      <span data-lang-en
        >Document data,<br />
        <span class="text-accent">analyzed with quantitative evidence</span></span
      >
    </Fragment>

    <Fragment slot="subtitle">
      <span data-lang-ko
        >IDA는 MetaInsight의 제품 경험을 기반으로, 구조화된 문서·레코드 데이터에서 키워드 클러스터와 시계열 시그널을
        찾고 분석 결과를 인사이트로 정리하는 문서 분석 AI 솔루션입니다.</span
      >
      <span data-lang-en
        >Built on the MetaInsight product experience, IDA is a document analytics AI that finds keyword clusters and
        time-series signals in structured document and record data, and packages the results as insights.</span
      >
    </Fragment>

    <Fragment slot="image">
      <div class="overflow-hidden rounded-md border border-gray-200 dark:border-slate-700 bg-slate-950 shadow-lg">
        <img
          src={overviewScreen.src}
          width={overviewScreen.width}
          height={overviewScreen.height}
          alt="MetaInsight analysis results dashboard"
          class="aspect-[16/10] w-full object-cover object-top"
          loading="eager"
        />
        <div class="grid grid-cols-3 border-t border-white/10 text-white">
          <div class="p-4">
            <span class="block text-xs uppercase text-blue-200">Input</span>
            <strong class="text-sm">Records</strong>
          </div>
          <div class="p-4 border-x border-white/10">
            <span class="block text-xs uppercase text-blue-200">Engine</span>
            <strong class="text-sm">Scoring</strong>
          </div>
          <div class="p-4">
            <span class="block text-xs uppercase text-blue-200">Output</span>
            <strong class="text-sm">Insights</strong>
          </div>
        </div>
      </div>
    </Fragment>
  </Hero2>

  <Features3
    tagline="Product Scope"
    title={bi('문서·레코드 분석을 위한 핵심 기능', 'Core features for document and record analysis')}
    subtitle={bi(
      'IDA는 텍스트와 날짜 축이 정리된 문서·레코드 데이터를 기준으로 분석을 시작합니다. 업로드, 컬럼 매핑, 클러스터링, 정량 평가, 인사이트 생성까지 이어지는 흐름을 하나의 화면 경험으로 제공합니다.',
      'IDA starts from document and record data that has a text axis and a date axis. Upload, column mapping, clustering, quantitative evaluation, and insight generation are all delivered as a single, unified screen experience.'
    )}
    columns={3}
    isDark
    items={[
      {
        title: bi('문서·레코드 업로드', 'Upload documents and records'),
        description: bi(
          'CSV, Excel, Parquet 파일을 업로드하고 텍스트, 날짜, 금액, 그룹, 식별자 컬럼을 화면에서 확인하며 분석 조건을 구성합니다.',
          'Upload CSV, Excel, or Parquet files, review the detected text/date/amount/group/identifier columns on screen, and configure the analysis.'
        ),
        icon: 'tabler:file-spreadsheet',
      },
      {
        title: bi('키워드 클러스터링', 'Keyword clustering'),
        description: bi(
          '비슷한 키워드와 문서 항목을 자동으로 묶고, 각 클러스터가 시간에 따라 어떻게 변화하는지 정량적으로 비교합니다.',
          'Group related keywords and document items automatically, then compare how each cluster shifts over time — quantitatively.'
        ),
        icon: 'tabler:category-2',
      },
      {
        title: bi('정량 근거 기반 인사이트', 'Evidence-backed insights'),
        description: bi(
          'C1 장기 트렌드, C2 모멘텀 유지, C3 최근 가속 기준을 바탕으로 등급과 점수를 산출하고 자연어 인사이트를 제공합니다.',
          'Compute grades and scores from three criteria — C1 long-term trend, C2 momentum, C3 recent acceleration — and deliver natural-language insights.'
        ),
        icon: 'tabler:report-analytics',
      },
    ]}
  />

  <Steps
    tagline="Analysis Workflow"
    title={bi('업로드부터 인사이트까지 이어지는 운용 흐름', 'A flow that runs from upload to insight')}
    subtitle={bi(
      '사용자는 복잡한 코드 없이 분석 파일을 올리고, 자동 감지된 컬럼을 검토한 뒤 프리셋을 선택해 분석을 실행합니다. 결과는 요약 지표, 차트, 항목 상세, 자연어 인사이트로 나누어 확인합니다.',
      'Users upload a file with no code, review the auto-detected columns, pick a preset, and run the analysis. Results show up as summary metrics, charts, item detail, and natural-language insights.'
    )}
    items={[
      {
        title: 'Upload',
        description: bi(
          '분석할 문서·레코드 데이터를 업로드하고 지원 형식을 확인합니다.',
          'Upload the documents or records to analyze and verify the supported file format.'
        ),
        icon: 'tabler:upload',
      },
      {
        title: 'Map Columns',
        description: bi(
          '텍스트와 날짜 컬럼을 중심으로 분석에 필요한 필드를 매핑합니다.',
          'Map the fields the analysis needs, anchored on the text and date columns.'
        ),
        icon: 'tabler:columns',
      },
      {
        title: 'Evaluate',
        description: bi(
          '키워드 군집을 만들고 트렌드 강도, 모멘텀, 최근 가속을 평가합니다.',
          'Build keyword clusters and score them on trend strength, momentum, and recent acceleration.'
        ),
        icon: 'tabler:wave-sine',
      },
      {
        title: 'Review Insights',
        description: bi(
          '요약 지표, 상세 항목, AI 또는 템플릿 기반 인사이트를 검토합니다.',
          'Review summary metrics, item detail, and AI- or template-based insights.'
        ),
        icon: 'tabler:report-analytics',
      },
    ]}
  />

  <Features2
    tagline="Signal Criteria"
    title={bi('정량 평가 엔진의 세 가지 기준', 'Three criteria behind the quantitative scoring engine')}
    subtitle={bi(
      '단순 키워드 빈도보다 중요한 것은 지속성, 현재성, 변화 속도입니다. IDA는 각 클러스터를 독립 기준으로 평가해 설명 가능한 점수와 등급으로 정리합니다.',
      'Persistence, recency, and rate of change matter more than raw keyword frequency. IDA evaluates each cluster against these independent criteria and turns them into explainable scores and grades.'
    )}
    columns={3}
    items={[
      {
        title: bi('C1 — 장기 트렌드', 'C1 — Long-term trend'),
        description: bi(
          '시간이 지나며 꾸준히 증가하는 클러스터인지 확인합니다.',
          'Does this cluster grow steadily over time?'
        ),
        icon: 'tabler:trending-up',
      },
      {
        title: bi('C2 — 모멘텀 유지', 'C2 — Momentum'),
        description: bi(
          '최근 구간의 활동이 기준선보다 높은 상태를 유지하는지 봅니다.',
          'Is recent activity holding above the baseline?'
        ),
        icon: 'tabler:activity',
      },
      {
        title: bi('C3 — 최근 가속', 'C3 — Recent acceleration'),
        description: bi(
          '현재 시점에 가까워질수록 격차가 더 커지는지 평가합니다.',
          'Is the gap widening as we approach the present?'
        ),
        icon: 'tabler:rocket',
      },
    ]}
  />

  <WidgetWrapper isDark containerClass="max-w-7xl mx-auto">
    <Headline
      tagline="Product Screens"
      title={bi('선택해서 보는 실제 화면', 'Pick a screen, see it live')}
      subtitle={bi(
        '의사결정에 필요한 장면을 선별했습니다. 왼쪽에서 관심 기능을 선택하면 오른쪽에서 실제 화면과 핵심 의미를 바로 확인할 수 있습니다.',
        'These are the views that matter for decisions. Pick a capability on the left and the real screen — plus what it actually means — shows up on the right.'
      )}
      classes={{
        container: 'text-center md:text-left rtl:md:text-right max-w-3xl',
        title: 'text-3xl md:text-4xl font-bold tracking-tight',
        subtitle: 'text-xl text-muted dark:text-slate-400',
      }}
    />

    <div class="relative isolate grid gap-6 lg:grid-cols-[0.72fr_1.28fr]" data-ida-screens>
      <div class="relative z-40 order-2 grid gap-3 sm:grid-cols-2 lg:order-1 lg:grid-cols-1 pointer-events-auto">
        {
          screenItems.map((item, index) => (
            <button
              type="button"
              class:list={[
                'group relative z-40 w-full cursor-pointer select-none overflow-hidden rounded-md border p-0 text-left transition bg-white dark:bg-slate-900 hover:shadow-md focus:outline-none focus:ring-2 focus:ring-primary pointer-events-auto',
                index === 1 ? 'border-primary ring-1 ring-primary' : 'border-gray-200 dark:border-slate-700',
              ]}
              data-ida-screen-trigger
              data-ida-active={index === 1 ? 'true' : 'false'}
              data-ida-image={item.image.src}
              data-ida-alt-ko={item.altKo}
              data-ida-alt-en={item.altEn}
              data-ida-title-ko={item.titleKo}
              data-ida-title-en={item.titleEn}
              data-ida-description-ko={item.descriptionKo}
              data-ida-description-en={item.descriptionEn}
              aria-pressed={index === 1 ? 'true' : 'false'}
            >
              <span class="grid min-h-[84px] grid-cols-[96px_1fr]">
                <span class="relative block bg-black">
                  <img
                    src={item.image.src}
                    width={item.image.width}
                    height={item.image.height}
                    alt=""
                    class="h-full w-full object-cover object-top opacity-80 transition group-hover:opacity-100"
                    loading="lazy"
                    aria-hidden="true"
                  />
                  <span class="pointer-events-none absolute inset-0 flex items-center justify-center bg-black/20">
                    <span class="flex h-9 w-9 items-center justify-center rounded-full bg-white text-primary">
                      <Icon name={item.icon} class="h-5 w-5" />
                    </span>
                  </span>
                </span>
                <span class="flex flex-col justify-center p-4">
                  <span class="text-sm font-bold text-heading dark:text-white">
                    <span data-lang-ko>{item.titleKo}</span>
                    <span data-lang-en set:html={item.titleEn} />
                  </span>
                  <span class="mt-1 text-xs leading-relaxed text-muted dark:text-slate-400">
                    <span data-lang-ko>{item.descriptionKo}</span>
                    <span data-lang-en>{item.descriptionEn}</span>
                  </span>
                </span>
              </span>
            </button>
          ))
        }
      </div>

      <article
        class="relative z-10 order-1 overflow-hidden rounded-md border border-gray-200 dark:border-slate-700 bg-white dark:bg-slate-900 shadow-lg lg:order-2"
      >
        <div class="bg-black">
          <img
            src={initialScreen.image.src}
            width={initialScreen.image.width}
            height={initialScreen.image.height}
            alt={initialScreen.altEn}
            class="aspect-[16/10] w-full object-cover object-top"
            loading="eager"
            data-ida-screen-image
          />
        </div>
        <div class="border-t border-gray-200 dark:border-slate-700 p-5 md:p-6">
          <div class="flex flex-col gap-4 md:flex-row md:items-start">
            <div class="flex h-11 w-11 shrink-0 items-center justify-center rounded-md bg-primary text-white">
              <Icon name={initialScreen.icon} class="h-6 w-6" data-ida-screen-icon />
            </div>
            <div class="min-w-0">
              <h3 class="text-xl font-bold text-heading dark:text-white" data-ida-screen-heading>
                <span data-lang-ko>{initialScreen.titleKo}</span>
                <span data-lang-en set:html={initialScreen.titleEn} />
              </h3>
              <p class="mt-2 leading-relaxed text-muted dark:text-slate-400" data-ida-screen-copy>
                <span data-lang-ko>{initialScreen.descriptionKo}</span>
                <span data-lang-en>{initialScreen.descriptionEn}</span>
              </p>
            </div>
          </div>
        </div>
      </article>
    </div>
  </WidgetWrapper>

  <Content
    isReversed
    tagline="Operation & Expansion"
    title={bi('분석 엔진을 제품으로 운용하기 위한 기반', 'The product foundation that runs the analysis engine')}
    items={[
      {
        title: bi('SaaS 운용 구조', 'SaaS operating structure'),
        description: bi(
          'JWT 인증, 프로젝트 단위 관리, 사용량 제한 등 SaaS 제품 운용에 필요한 기본 구조를 갖춥니다.',
          'JWT auth, per-project management, usage limits — the basics required to run as a SaaS product are in place.'
        ),
        icon: 'tabler:shield-check',
      },
      {
        title: bi('도메인 확장', 'Domain expansion'),
        description: bi(
          'R&D 과제, 특허, 리테일, 금융 리스크처럼 텍스트와 날짜 축이 있는 데이터로 분석 대상을 확장할 수 있습니다.',
          'Push the analysis target into any data with text and date axes: R&D programs, patents, retail, financial risk.'
        ),
        icon: 'tabler:database-search',
      },
      {
        title: bi('반복 탐색', 'Iterative exploration'),
        description: bi(
          '국가, 분야, 기간, 프리셋 등 조건을 조정하며 같은 데이터에서 다른 관점의 시그널을 확인합니다.',
          'Vary country, field, time window, and preset to surface different signals from the same data.'
        ),
        icon: 'tabler:refresh-dot',
      },
    ]}
    image={{
      src: mobileScreen,
      alt: 'MetaInsight mobile projects screen',
    }}
  >
    <Fragment slot="content">
      <p class="text-lg leading-relaxed text-muted dark:text-slate-400">
        <span data-lang-ko
          >MetaInsight는 분석 엔진만이 아니라 계정, 프로젝트, 결과 저장, 내보내기, 모바일 대응 화면까지 포함한 제품형
          구조를 갖추고 있습니다. IDA는 이 기반 위에서 기업 문서·규제·과제 데이터 분석 영역으로 확장됩니다.</span
        >
        <span data-lang-en
          >MetaInsight is more than an analytics engine — it includes accounts, projects, saved results, export, and
          mobile-ready screens. IDA extends that foundation into enterprise document, regulatory, and program data
          analysis.</span
        >
      </p>
    </Fragment>
  </Content>

  <script is:inline data-astro-rerun>
    (() => {
      const getTrigger = (target) => (target instanceof Element ? target.closest('[data-ida-screen-trigger]') : null);

      const findIdaScreenTriggerFromPoint = (root, clientX, clientY) => {
        const directTrigger = document.elementFromPoint(clientX, clientY)?.closest?.('[data-ida-screen-trigger]');
        if (directTrigger && root.contains(directTrigger)) {
          return directTrigger;
        }

        return Array.from(root.querySelectorAll('[data-ida-screen-trigger]')).find((trigger) => {
          const rect = trigger.getBoundingClientRect();
          return clientX >= rect.left && clientX <= rect.right && clientY >= rect.top && clientY <= rect.bottom;
        });
      };

      const escapeHtml = (s) =>
        String(s ?? '').replace(
          /[&<>"']/g,
          (c) =>
            ({
              '&': '&amp;',
              '<': '&lt;',
              '>': '&gt;',
              '"': '&quot;',
              "'": '&#39;',
            })[c]
        );

      const buildBilingual = (ko, en, { rawEn = false } = {}) =>
        `<span data-lang-ko>${escapeHtml(ko)}</span><span data-lang-en>${rawEn ? String(en ?? '') : escapeHtml(en)}</span>`;

      const setActiveIdaScreen = (root, selectedButton) => {
        const image = root.querySelector('[data-ida-screen-image]');
        const heading = root.querySelector('[data-ida-screen-heading]');
        const copy = root.querySelector('[data-ida-screen-copy]');
        const buttons = root.querySelectorAll('[data-ida-screen-trigger]');

        if (!(image instanceof HTMLImageElement) || !selectedButton) {
          return;
        }

        buttons.forEach((button) => {
          const isActive = button === selectedButton;
          button.setAttribute('data-ida-active', String(isActive));
          button.setAttribute('aria-pressed', String(isActive));
          button.classList.toggle('border-primary', isActive);
          button.classList.toggle('ring-1', isActive);
          button.classList.toggle('ring-primary', isActive);
          button.classList.toggle('border-gray-200', !isActive);
          button.classList.toggle('dark:border-slate-700', !isActive);
        });

        const nextImage = selectedButton.getAttribute('data-ida-image');
        const nextAltKo = selectedButton.getAttribute('data-ida-alt-ko') || '';
        const nextAltEn = selectedButton.getAttribute('data-ida-alt-en') || '';
        const nextTitleKo = selectedButton.getAttribute('data-ida-title-ko') || '';
        const nextTitleEn = selectedButton.getAttribute('data-ida-title-en') || '';
        const nextDescKo = selectedButton.getAttribute('data-ida-description-ko') || '';
        const nextDescEn = selectedButton.getAttribute('data-ida-description-en') || '';

        if (nextImage && image.getAttribute('src') !== nextImage) {
          image.removeAttribute('srcset');
          image.setAttribute('src', nextImage);
        }
        const lang = document.documentElement.lang === 'ko' ? 'ko' : 'en';
        image.setAttribute('alt', lang === 'ko' ? nextAltKo : nextAltEn);
        if (heading) heading.innerHTML = buildBilingual(nextTitleKo, nextTitleEn, { rawEn: true });
        if (copy) copy.innerHTML = buildBilingual(nextDescKo, nextDescEn);
      };

      window.selectIdaScreen = (selectedButton) => {
        const root = selectedButton?.closest?.('[data-ida-screens]');
        if (!root) {
          return;
        }

        setActiveIdaScreen(root, selectedButton);
      };

      const initIdaScreens = () => {
        document.querySelectorAll('[data-ida-screens]').forEach((root) => {
          if (root.dataset.idaScreensReady === 'true') {
            return;
          }

          root.dataset.idaScreensReady = 'true';
        });
      };

      if (!window.idaScreenSelectReady) {
        window.idaScreenSelectReady = true;

        document.addEventListener(
          'click',
          (event) => {
            const trigger = getTrigger(event.target);
            if (!trigger) {
              return;
            }

            event.preventDefault();
            window.selectIdaScreen(trigger);
          },
          true
        );

        document.addEventListener(
          'pointerup',
          (event) => {
            let trigger = getTrigger(event.target);
            if (!trigger) {
              const root = event.target instanceof Element ? event.target.closest('[data-ida-screens]') : null;
              if (root) {
                trigger = findIdaScreenTriggerFromPoint(root, event.clientX, event.clientY);
              }
            }

            if (!trigger) {
              return;
            }

            event.preventDefault();
            window.selectIdaScreen(trigger);
          },
          true
        );

        document.addEventListener('astro:page-load', initIdaScreens);
      }

      initIdaScreens();
    })();
  </script>
</Layout>
