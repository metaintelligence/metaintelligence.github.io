---
import Layout from '~/layouts/PageLayout.astro';

import Header from '~/components/widgets/Header.astro';
import Hero2 from '~/components/widgets/Hero2.astro';
import Content from '~/components/widgets/Content.astro';
import Features2 from '~/components/widgets/Features2.astro';
import Stats from '~/components/widgets/Stats.astro';

import { headerData } from '~/navigation';
import ko from '~/i18n/ko.json';
import en from '~/i18n/en.json';
import { i18nPairHtml } from '~/utils/i18n';

const koPage = ko.introductionPage;
const enPage = en.introductionPage;

const metadata = {
  title: koPage.title || 'Identity & Values — MetaIntelligence',
};

const bi = (k: string, e: string) => `<span data-lang-ko>${k}</span><span data-lang-en>${e}</span>`;
---

<Layout metadata={metadata}>
  <Fragment slot="header">
    <Header {...headerData} isSticky showToggleTheme showToggleLanguage />
  </Fragment>

  <Hero2
    tagline="Who We Are"
    actions={[{ variant: 'primary', text: 'Our Technology', href: '/tech/core-tech' }]}
    image={{
      src: 'https://images.unsplash.com/photo-1451187580459-43490279c0fa?auto=format&fit=crop&w=2072&q=80',
      alt: 'MetaIntelligence Identity Image',
    }}
  >
    <Fragment slot="title">
      <span data-lang-ko>{koPage.hero.title}</span>
      <span data-lang-en>{enPage.hero.title}</span>
    </Fragment>

    <Fragment slot="subtitle">
      <span data-lang-ko
        >MetaIntelligence는 단순한 기술 구현을 넘어, 인류가 마주한 복잡한 문제의 <strong>본질을 통찰</strong>하고
        실질적인 <strong>가치를 설계</strong>합니다. 공학적 완성도를 바탕으로 산업 현장에 지능형 솔루션을 이식하는 것이
        우리의 사명입니다.</span
      >
      <span data-lang-en
        >Beyond mere implementation, MetaIntelligence sees through the <strong>essence</strong> of the complex problems facing
        humanity and <strong>designs tangible value</strong>. Our mission is to bring intelligent solutions into
        industrial sites, grounded in engineering excellence.</span
      >
    </Fragment>
  </Hero2>

  <Features2
    title="Our Core Identity"
    subtitle={bi('우리가 추구하는 가치와 존재의 이유', 'The values we pursue and our reason for being')}
    items={[
      {
        title: koPage.identity.title,
        description: i18nPairHtml('introductionPage.identity.content'),
        icon: 'tabler:fingerprint',
      },
      {
        title: koPage.mission.title,
        description: i18nPairHtml('introductionPage.mission.content'),
        icon: 'tabler:rocket',
      },
      {
        title: koPage.slogan.title,
        description: i18nPairHtml('introductionPage.slogan.content'),
        icon: 'tabler:bulb',
      },
    ]}
  />

  <Content
    isReversed
    tagline="Values 01"
    title="Insight into Essence"
    items={[
      {
        title: bi('문제의 이면을 봅니다', 'Looking beyond the surface'),
        description: bi(
          '우리는 데이터의 나열에서 멈추지 않습니다. 현상 뒤에 숨겨진 근본 원인(Root Cause)을 다각도로 분석하여 해결의 실마리를 찾습니다.',
          'We do not stop at listing data. We analyze the root cause hidden beneath every phenomenon from multiple angles to uncover the path to a real solution.'
        ),
      },
      {
        title: bi('물리학 기반 모델링', 'Physics-Informed Modeling'),
        description: bi(
          '데이터가 부족한 극한의 환경에서도 물리 법칙과 AI를 결합한 Physics-Informed Modeling을 통해 정교한 통찰을 제공합니다.',
          'Even in extreme environments where data is scarce, we deliver precise insight through Physics-Informed Modeling that combines physical laws with AI.'
        ),
      },
    ]}
    image={{
      src: 'https://images.unsplash.com/photo-1507413245164-6160d8298b31?auto=format&fit=crop&w=2070&q=80',
      alt: 'Insight Image',
    }}
  >
    <Fragment slot="content">
      <h3 class="text-2xl font-bold tracking-tight dark:text-white sm:text-3xl mb-2">
        <span data-lang-ko>본질을 꿰뚫는 분석력</span>
        <span data-lang-en>Analytics that pierce through the essence</span>
      </h3>
      <span data-lang-ko>복잡한 수식과 데이터 속에서 가장 명확한 해답을 이끌어냅니다.</span>
      <span data-lang-en>We draw the clearest answers from complex equations and data.</span>
    </Fragment>
  </Content>

  <Content
    isAfterContent
    tagline="Values 02"
    title="Design for Value"
    items={[
      {
        title: bi('실용적 솔루션 공급', 'Practical solutions'),
        description: bi(
          '화려한 기술보다는 실제 현장에서 작동하고 생산성을 높이는 실용성을 우선합니다.',
          'We prioritize practicality that actually works on the ground and lifts productivity, over flashy technology.'
        ),
      },
      {
        title: bi('유연한 아키텍처', 'Flexible architecture'),
        description: bi(
          '변화하는 비즈니스 요구사항에 기민하게 대응할 수 있는 고품질 소프트웨어 설계를 지향합니다.',
          'We pursue high-quality software design that responds nimbly to evolving business requirements.'
        ),
      },
    ]}
    image={{
      src: 'https://images.unsplash.com/photo-1581092580497-e0d23cbdf1dc?auto=format&fit=crop&w=2070&q=80',
      alt: 'Value Design Image',
    }}
  >
    <Fragment slot="content">
      <h3 class="text-2xl font-bold tracking-tight dark:text-white sm:text-3xl mb-2">
        <span data-lang-ko>지속 가능한 가치 창출</span>
        <span data-lang-en>Creating sustainable value</span>
      </h3>
      <span data-lang-ko>고객의 비즈니스 성장을 최우선으로 고려한 지능형 시스템을 설계합니다.</span>
      <span data-lang-en>We design intelligent systems with our clients' business growth as the top priority.</span>
    </Fragment>
  </Content>

  <Stats
    title="Proven Expertise"
    stats={[
      { title: 'R&D Projects', amount: '15+' },
      { title: 'Core Patents', amount: '10+' },
      { title: 'Engineering Experience', amount: '10y+' },
      { title: 'Client Satisfaction', amount: '98%' },
    ]}
  />
</Layout>
