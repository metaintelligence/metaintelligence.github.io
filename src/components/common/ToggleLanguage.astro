---
export interface Props {
  label?: string;
  class?: string;
}

const {
  label = '한국어 / English',
  class:
    className = 'text-muted dark:text-gray-400 hover:bg-gray-100 dark:hover:bg-gray-700 focus:outline-none focus:ring-4 focus:ring-gray-200 dark:focus:ring-gray-700 rounded-lg text-sm font-semibold p-2.5 inline-flex items-center min-w-[3.25rem] justify-center',
} = Astro.props;
---

<button type="button" class={className} aria-label={label} data-aw-toggle-language>
  <span data-lang-ko>EN</span>
  <span data-lang-en>KO</span>
</button>
